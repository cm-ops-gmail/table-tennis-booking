# --- Google Sheets service account (share the spreadsheet with GOOGLE_CLIENT_EMAIL as Editor) ---
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your-google-sheet-id

# --- 10MS SSO login (frontend, Vite) ---
# Register the client's redirect URI as your site origin (e.g.
# http://localhost:5173 for dev, https://your-app.vercel.app for prod).
VITE_TENMS_CLIENT_ID=tenms_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin access ---
# Comma-separated emails that get the Admin view. Editable later in the
# sheet's Config tab (ADMIN_EMAILS); this env var is the fallback.
ADMIN_EMAILS=someone@10minuteschool.com

# --- Settings (all optional; shown with their defaults) ---
HR_ADMIN_EMAIL=hr@10minuteschool.com
HR_ADMIN_NAME=HR Admin
BOOKING_HORIZON_DAYS=14
ALLOW_RATING_EDIT=true
FACILITY_START=1:00 PM
FACILITY_END=5:30 PM

# --- Local dev only ---
PORT=3001
